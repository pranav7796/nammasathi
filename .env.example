# Safe local default. The mock adapter is used for tests and demos.
COMMERCE_BACKEND=mock
SWIGGY_LIVE_ACCESS=false
# Live reads need SWIGGY_LIVE_ACCESS. Changing the real cart and placing a real
# order are each separately off. See docs/first-real-order.md before changing them.
ALLOW_SWIGGY_CART_WRITES=false
ALLOW_REAL_CHECKOUT=false
# Booking a real table on Swiggy Dineout has its own switch.
ALLOW_REAL_BOOKING=false
# Required when ALLOW_REAL_CHECKOUT=true: refuse any order above this total.
MAX_REAL_ORDER_INR=
# Orders the journal may ever record before a person raises this. Default 1.
REAL_ORDER_LIMIT=1
ORDER_JOURNAL_PATH=var/order_attempts.jsonl

# Who interprets speech first: groq (about 1 s) or gemini (5 to 13 s). Each gets one try of
# LLM_TIMEOUT_SECONDS before the next takes over.
LLM_PRIMARY=groq
LLM_TIMEOUT_SECONDS=10
# llm, fallback (rule-based after every LLM fails), or scripted (no LLM). Mock mode only, and the
# page says so whenever it was used.
DEMO_UNDERSTANDING=llm

# A public server runs the mock shops only and refuses anything else. See docs/deployment.md.
PUBLIC_DEPLOYMENT=false
PUBLIC_BASE_URL=
PUBLIC_DAILY_TURN_LIMIT=300
PUBLIC_MAX_SESSIONS=50

# Never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Last resort, mock mode on this machine only, since its free model may log requests.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Gnani Speech REST. Each Timbre v2.5 voice has one preferred language, so leaving
# GNANI_TTS_VOICE empty selects a suitable voice per conversation language.
GNANI_API_KEY=
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=
GNANI_TTS_SPEED=0.90
GNANI_TIMEOUT_SECONDS=20

# Used only when COMMERCE_BACKEND=swiggy. Food and Dineout use the same host. Staging (https://mcp-staging.swiggy.com/im)
# is accepted once Swiggy has granted it; confirm that exact path with them.
SWIGGY_MCP_URL=https://mcp.swiggy.com/im
