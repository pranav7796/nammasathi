# Safe local default. The mock adapter is used for tests and demos.
COMMERCE_BACKEND=mock
SWIGGY_LIVE_ACCESS=false
ALLOW_REAL_CHECKOUT=false

# Required only for the Gemini text demo; never commit the real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_FALLBACK_MODELS=2

# Optional intent-extraction fallback; invoked after Gemini quota exhaustion or
# HTTP 502/503/504. Groq is tried before OpenRouter.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Final intent-extraction fallback after Groq fails.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Gnani Speech REST. Timbre v2.5 voices are multilingual; the selected session
# locale is passed separately for every STT and TTS request.
GNANI_API_KEY=
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Saanvi
GNANI_TTS_SPEED=0.90
GNANI_TIMEOUT_SECONDS=60

# Used only when COMMERCE_BACKEND=swiggy.
SWIGGY_MCP_URL=https://mcp.swiggy.com/im
